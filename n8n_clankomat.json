    {
      "parameters": {
        "jsCode": "const ENTITIES = {\n  nove_vedeni: [\n    { name: 'Daniel Vondra', pattern: /\\b(vondr[ayueio]|vondrovi|vondrou)\\b/i, role: 'Náměstek (STAN) - školství, urbanismus' },\n    { name: 'Martin Slezák', pattern: /\\b(slezák[uae]?|slezákovi|slezákem|slezak)\\b/i, role: 'Náměstek (Progresivní Pardubice / TOP 09) - doprava, IT' },\n    { name: 'Jan Mazuch', pattern: /\\b(mazuch[aou]?|mazuchovi|mazuchem)\\b/i, role: 'Náměstek (ODS) - finance, rozpočet' },\n    { name: 'Kateřina Kosová', pattern: /\\b(kosov[áéou]|kosová)\\b/i, role: 'Náměstkyně (Naše Pardubice) - ŽP, zakázky' },\n    { name: 'Petr Netolický', pattern: /\\b(netolick[ýéhoémuým]|netolicky)\\b/i, role: 'Náměstek (KDU-ČSL) - majetek, kultura, soc. věci' },\n    { name: 'Filip Sedlák', pattern: /\\b(sedlák[uae]?|sedlákovi|sedlákem|sedlak)\\b/i, role: 'Starosta MO Pardubice I (Naše Pardubice)' },\n    { name: 'Dušan Stránský', pattern: /\\b(stránsk[ýéhoémuým]|stransky)\\b/i, role: 'Radní města (ODS)' },\n    { name: 'Jiří Hájek', pattern: /\\b(hájk[uae]|hájkovi|hájkem|hajek)\\b/i, role: 'Radní města (STAN)' },\n    { name: 'Šárka Kuchtová', pattern: /\\b(kuchtov[áéou]|kuchtova)\\b/i, role: 'Radní města (STAN)' },\n    { name: 'Bohdan Šeda', pattern: /\\b(šed[ayeou]|šedovi|bohdan[a]? šed[ay]?)\\b/i, role: 'Radní města (Naše Pardubice)' }\n  ],\n  stare_vedeni: [\n    { name: 'Jan Nadrchal', pattern: /\\b(nadrchal[aou]?|nadrchalovi|nadrchalem)\\b/i },\n    { name: 'Jiřina Klčová', pattern: /\\b(klčov[áéou]|klcova)\\b/i },\n    { name: 'Vít Hrabal', pattern: /\\b(hrabal[aou]?|hrabalovi|hrabalem)\\b/i },\n    { name: 'Jakub Rychtecký', pattern: /\\b(rychteck[ýéhoémuým]|rychtecky)\\b/i },\n    { name: 'Petr Kvaš', pattern: /\\b(kvaš[eaou]?|kvašovi|kvas)\\b/i },\n    { name: 'Alexandr Salfický', pattern: /\\b(salfick[ýéhoémuým]|salficky)\\b/i },\n    { name: 'Martin Charvát', pattern: /\\b(charvát[aou]?|charvat)\\b/i }\n  ],\n  kauzy_a_projekty: [\n    { tag: 'multifunkcni_arena', pattern: /\\b(arén[ayueio]|aren[ay]|hala v cihelně|dědk[ova]* arén[a]|ciheln[aě])\\b/i },\n    { tag: 'letni_stadion', pattern: /\\b(letní[ho]? stadion[u]?|cfig arén[ay]|stadion pod vinicí)\\b/i },\n    { tag: 'automaticke_mlyny', pattern: /\\b(automatick[éých]* mlýn[yů]|winternitz|gampa|gočár)\\b/i },\n    { tag: 'terminal_jih', pattern: /\\b(terminál[u]? jih|přednádraží|lávk[ay] přes labe|lávk[aou] k nádraží)\\b/i },\n    { tag: 'obchvaty_doprava', pattern: /\\b(severovýchodní obchvat|jihovýchodní obchvat|nadjezd kyjevská|podjezd 17\\. listopadu)\\b/i },\n    { tag: 'spalovna_rybitvi', pattern: /\\b(spalovn[ayueio]|rybitv[íi]|ave cz)\\b/i },\n    { tag: 'revize_obvodu', pattern: /\\b(reviz[ie] obvod[ůu]|rušení obvod[ůu]|městsk[éých] obvod[ůu]|obvodní radnic[ie])\\b/i }\n  ],\n  mestske_firmy: [\n    { tag: 'dpmp', pattern: /\\b(dpmp|dopravní[ho]? podnik[u]? města pardubic)\\b/i },\n    { tag: 'sluzby_mesta', pattern: /\\b(smp|služb[ay] města pardubic)\\b/i },\n    { tag: 'rozvojovy_fond', pattern: /\\b(rozvojov[ýého]* fond[u]?|rfp)\\b/i }\n  ]\n};\n\nfunction detectSource(url) {\n  if (url.includes('idnes.cz')) return 'iDNES Pardubice';\n  if (url.includes('denik.cz')) return 'Pardubický Deník';\n  if (url.includes('rozhlas.cz')) return 'Český rozhlas Pardubice';\n  if (url.includes('pardubicezive.eu')) return 'Pardubice Živě';\n  return 'Regionální zprávy';\n}\n\nconst seenUrls = new Set();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const rawUrl = data.link || data.guid || '';\n  if (!rawUrl) continue;\n\n  let cleanUrl = rawUrl;\n  try {\n    const urlObj = new URL(rawUrl);\n    urlObj.searchParams.delete('utm_source');\n    urlObj.searchParams.delete('utm_medium');\n    urlObj.searchParams.delete('utm_campaign');\n    urlObj.searchParams.delete('utm_content');\n    cleanUrl = urlObj.origin + urlObj.pathname;\n  } catch (e) {\n    cleanUrl = rawUrl.split('?')[0];\n  }\n\n  if (seenUrls.has(cleanUrl)) continue;\n  seenUrls.add(cleanUrl);\n\n  const title = (data.title || '').trim();\n  const rawDesc = data.contentSnippet || data.content || data.description || '';\n  const cleanDesc = rawDesc.replace(/<[^>]*>?/gm, '').trim();\n  const searchableText = `${title} ${cleanDesc}`;\n\n  const matchedNewLeaders = [];\n  const matchedOldLeaders = [];\n  const matchedIssues = [];\n  const matchedCompanies = [];\n\n  for (const person of ENTITIES.nove_vedeni) {\n    if (person.pattern.test(searchableText)) {\n      matchedNewLeaders.push({ name: person.name, role: person.role });\n    }\n  }\n\n  for (const person of ENTITIES.stare_vedeni) {\n    if (person.pattern.test(searchableText)) {\n      matchedOldLeaders.push(person.name);\n    }\n  }\n\n  for (const issue of ENTITIES.kauzy_a_projekty) {\n    if (issue.pattern.test(searchableText)) {\n      matchedIssues.push(issue.tag);\n    }\n  }\n\n  for (const comp of ENTITIES.mestske_firmy) {\n    if (comp.pattern.test(searchableText)) {\n      matchedCompanies.push(comp.tag);\n    }\n  }\n\n  const isRelevant = (\n    matchedNewLeaders.length > 0 ||\n    matchedOldLeaders.length > 0 ||\n    matchedIssues.length > 0 ||\n    matchedCompanies.length > 0\n  );\n\n  results.push({\n    json: {\n      title,\n      link: cleanUrl,\n      source: detectSource(cleanUrl),\n      pubDate: data.pubDate || data.isoDate || new Date().toISOString(),\n      perex: cleanDesc.slice(0, 500),\n      isRelevant,\n      entities: {\n        newLeadership: matchedNewLeaders,\n        oldLeadership: matchedOldLeaders,\n        issues: matchedIssues,\n        companies: matchedCompanies\n      }\n    }\n  });\n}\n\nreturn results;"
      },
